    <article class="channel-card">
      <div class="poster">
{% if channel.poster_path %}
        <img src="{{ channel.poster_path }}" alt="" loading="lazy">
{% endif %}
      </div>
      <div class="channel-body">
        <h2>{{ channel.name }}</h2>
        <p>{{ channel.description }}</p>
        <label>
          <span>RTSP URL</span>
          <span class="url">{{ channel.rtsp_url }}</span>
        </label>
        <div class="actions">
          <button type="button" data-copy="{{ channel.rtsp_url }}">Copy URL</button>
          <a href="{{ channel.vlc_url }}">Open in VLC</a>
        </div>
      </div>
    </article>
